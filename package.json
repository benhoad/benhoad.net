{
  "name": "benhoad",
  "version": "18",
  "description": "The code that powers https://benhoad.net",
  "private": true,
  "scripts": {
    "favicon": "node tools/make-favicon.mjs",
    "vendor:three": "node tools/vendor-three.mjs",
    "prestart": "npm run vendor:three",
    "start": "hey run",
    "textures": "node tools/check-textures.mjs",
    "textures:fix": "node tools/check-textures.mjs --fix",
    "prebuild": "npm run vendor:three",
    "build": "hey build && node tools/make-feed.mjs && node tools/check-textures.mjs --quiet",
    "prepreview": "npm run build",
    "preview": "node tools/preview.mjs"
  },
  "author": "Ben Hoad",
  "homepage": "https://github.com/benhoad/benhoad#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/benhoad/benhoad.git"
  },
  "license": "ISC",
  "dependencies": {
    "@nathanhoad/hey": "^1.8.1",
    "three": "^0.185.1"
  },
  "overrides": {
    "node-sass": "npm:sass@^1.77.0"
  }
}
