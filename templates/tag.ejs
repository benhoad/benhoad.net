<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <title>#<%= tag %> - Ben Hoad</title>
    <meta property="og:title" content="#<%= tag %> - Ben Hoad" />
    <meta name="description" content="Posts tagged with #<%= tag %>" />
    <meta property="og:description" content="Posts tagged with #<%= tag %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ben Hoad" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content="https://benhoad.net/share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A custom-built mini PC styled as the Hooli Signature Edition Box 3; one of Ben's projects"
    />
    <%# Tags can contain spaces ("3d printing"); hey names the directory
        verbatim, so the URL needs the segment percent-encoded to be valid. %>
    <meta property="og:url" content="https://benhoad.net/tags/<%= encodeURIComponent(tag) %>/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@benhoad" />
    <link rel="canonical" href="https://benhoad.net/tags/<%= encodeURIComponent(tag) %>/" />
    <meta name="author" content="Ben Hoad" />
    <meta name="robots" content="max-image-preview:large" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Hoad"
      href="https://benhoad.net/feed.xml"
    />

    <meta
      name="verify-v1"
      content="FJjra037EqYRGo8w0Atq5BHkBi8B+MPZSD+0jKQebLs="
    />
    <meta name="p:domain_verify" content="5c8fe00840c14d6c92865fc017137b69" />
    <meta
      name="viewport"
      content="width=device-width, minimum-scale=1.0, maximum-scale=1.0"
    />
    <link type="image/png" href="/favicon.png" rel="icon" />
    <meta name="theme-color" content="#0B0B10" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jersey+10&family=Enriqueta:wght@400;700&family=Open+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <aside>
      <a href="/">benhoad.net</a>
    </aside>

    <main class="tag">
      <header>
        <h1>#<%= tag %></h1>
      </header>
      <section class="contents">
        <ul>
          <% posts.forEach(post => { %>
          <li>
            <h2><a href="/<%= post.slug %>/"><%= post.title %></a></h2>
            <aside class="meta">
              <%= ['January', 'February', 'March', 'April', 'May', 'June',
              'July', 'August', 'September', 'October', 'November',
              'December'][post.headers.published.getMonth()] %> <%=
              post.headers.published.getFullYear() %>
            </aside>
          </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <%- include('footer') %>
  </body>
</html>
