<!DOCTYPE html>
<%# .home on the root element too: the background wash is keyed off it, and
    that lives on the root rather than on body. See styles.scss. %>
<html lang="en-AU" class="home">
  <head>
    <meta charset="utf-8" />
    <%# The title is the site's answer to a name query; plain prose stating
        who and what, site name exactly once. Google rewrites titles it judges
        keyword-stuffed, so resist decorating this. %>
    <title>Ben Hoad :: Software Engineer in Australia</title>
    <meta
      property="og:title"
      content="Ben Hoad; Software Engineer in Australia"
    />
    <meta
      name="description"
      content="I'm Ben Hoad, a remote software engineer based in Australia. I build random things; sometimes they're useful, other times they're just for fun."
    />
    <meta
      property="og:description"
      content="I'm Ben Hoad, a remote software engineer based in Australia. I build random things; sometimes they're useful, other times they're just for fun."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ben Hoad" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content="https://benhoad.net/share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A custom-built mini PC styled as the Hooli Signature Edition Box 3; one of Ben's projects"
    />
    <meta property="og:url" content="https://benhoad.net/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@benhoad" />
    <link rel="canonical" href="https://benhoad.net/" />
    <meta name="author" content="Ben Hoad" />
    <%# max-image-preview:large is a prerequisite for large-image treatment in
        Google Discover, and preview restrictions (nosnippet/max-snippet) are
        documented to limit what AI Overviews may quote; so grant, never
        restrict. %>
    <meta name="robots" content="max-image-preview:large" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Hoad"
      href="https://benhoad.net/feed.xml"
    />
    <meta name="theme-color" content="#0B0B10" />
    <%# WebSite tells Google what site name to show in results; Person is the
        entity home half of name-query SEO. The Person node lives in
        jsonld-person.ejs; one source of truth, parsed back into the graph. %>
    <% const person = JSON.parse(include("jsonld-person")); %>
    <script type="application/ld+json"><%- JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://benhoad.net/#website",
          url: "https://benhoad.net/",
          name: "Ben Hoad",
          alternateName: "benhoad.net",
          description:
            "I'm Ben Hoad, a remote software engineer based in Australia. I build random things; sometimes they're useful, other times they're just for fun.",
          inLanguage: "en-AU",
          publisher: { "@id": "https://benhoad.net/#ben" }
        },
        person
      ]
    }) %></script>

    <meta
      name="google-site-verification"
      content="wtlEOFJ0tj_1UxYEj6Yoru93npUE6Gx0ahj8rrP5nik+MPZSD+0jKQebLs="
    />
    <meta name="p:domain_verify" content="af2f718c472c4377aa9bccb03e81aa4e" />

    <meta
      name="viewport"
      content="width=device-width, minimum-scale=1.0, maximum-scale=1.0"
    />
    <link type="image/png" href="/favicon.png" rel="icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jersey+10&family=Enriqueta:wght@400;700&family=Open+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="home">
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="crt" aria-hidden="true"></div>

    <header class="masthead">
      <a href="/" class="wordmark">benhoad.net</a>
      <p class="strapline">
        I build random things; sometimes they're useful, other times
        they're just for fun.
      </p>

      <%# Revealed by scene.js only on devices that gate device orientation
          behind a permission prompt (iOS 13+), because that prompt has to be
          triggered by a real tap. Everywhere else tilt either just works or
          is unavailable, and this stays hidden. %>
      <button id="tilt" class="tilt-toggle" type="button" hidden>
        Tilt to look around
      </button>
    </header>

    <main class="feed">
      <ol class="posts">
        <%# The blurb derivation lives in blurb.ejs, shared with the post
            page's meta description. %>
        <% posts.forEach((post, i) => { %>
        <li
          class="post-row"
          data-index="<%= i %>"
          data-slug="<%= post.slug %>"
          data-tags="<%= (post.headers.tags || []).join(',') %>"
          <%
          /* `model: thing.glb` in the post's header list. The file lives in the
             post folder alongside its images; compilePost copies everything in
             there; so a bare filename resolves under the post's own URL. A
             post without one keeps the procedural primitive. */
          if (post.headers.model) { %>
          data-model="/<%= post.slug %>/<%= post.headers.model %>"
          <% } %>
        >
          <span class="post-num" aria-hidden="true"
            ><%= String(i + 1).padStart(2, '0') %></span
          >
          <div class="post-body">
            <h2 class="post-title">
              <a href="/<%= post.slug %>/"><%= post.title %></a>
            </h2>
            <p class="post-meta">
              <%= ['January', 'February', 'March', 'April', 'May', 'June',
              'July', 'August', 'September', 'October', 'November',
              'December'][post.headers.published.getMonth()] %> <%=
              post.headers.published.getFullYear() %>
            </p>
            <p class="post-blurb"><%= include("blurb", { post: post }) %></p>
          </div>
        </li>
        <% }) %>
      </ol>
    </main>

    <%- include('footer') %>

    <script type="module" src="/scene.js"></script>
    <script src="/cheet.js"></script>
  </body>
</html>
